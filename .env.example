# ==============================================================================
# FLEETOPS CLOUD — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your local or production settings.
# NEVER commit the real .env file into version control.

# Django core settings
DJANGO_ENV=development
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-fleetops-secret-key-placeholder
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleetops_db

# Static & Media storage
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# Security settings (Production defaults, overridden in development)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
